{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate --schema=prisma/schema.prisma && next build --no-lint",
  "outputDirectory": ".next",
  "env": {
    "DATABASE_URL": "@shoot_neon_database_url",
    "JWT_SECRET": "@shoot_jwt_secret"
  }
}
